# Google Cloud (source, read-only). Live inventory arrives in M3.
GCP_PROJECT=
# Path to a read-only service account key, or leave unset to use
# Application Default Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# Oracle AIDP (destination)
# Default OCI Object Storage namespace for gs:// → oci:// translation.
# Find yours with: oci os ns get
OCI_NAMESPACE=
